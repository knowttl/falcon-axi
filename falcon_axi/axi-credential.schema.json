{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "falcon-axi credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["clientId"],
  "properties": {
    "region": {"type": "string", "minLength": 1},
    "memberCid": {"type": "string", "minLength": 1},
    "clientId": {"type": "string", "minLength": 1},
    "clientSecret": {
      "x-secret": true,
      "default": {"env": "FALCON_AXI_CLIENT_SECRET"},
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": {"env": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {"file": {"type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])"}}
        }
      ]
    }
  }
}
